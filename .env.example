APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bankertrader
DB_USERNAME=root
DB_PASSWORD=

# PostgreSQL example
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=bankertrader
# DB_USERNAME=postgres
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Gemini API (AI social post generation) — env fallback only; the key is
# normally set via the admin console (trading_configs: gemini.api_key), which
# takes precedence. See config/gemini.php / HttpGeminiClient.
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_RPM=10
GEMINI_RPD=20
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Passport password-grant client for API/mobile auth (php artisan passport:client --password --name="BankerTrader Mobile")
PASSPORT_PASSWORD_CLIENT_ID=
PASSPORT_PASSWORD_SECRET=
# Optional when keys are stored on disk (default: storage/oauth-*.key)
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=

# Upstox broker (register app at https://upstox.com/developer/apps)
UPSTOX_APP_ID=
UPSTOX_APP_SECRET=
UPSTOX_REDIRECT_URL=http://localhost:8000/api/broker/upstox/callback
# NOTE: Upstox sandbox restricts all endpoints except order place/modify/cancel.
# Leave false for live trading; enable true only for order-flow testing.
UPSTOX_SANDBOX=false
UPSTOX_API_BASE=https://api.upstox.com/v2
UPSTOX_LOGIN_URL=https://api.upstox.com/v2/login/authorization/dialog
UPSTOX_TOKEN_URL=https://api.upstox.com/v2/login/authorization/token

# Angel One (SmartAPI) broker (register app at https://smartapi.angelone.in)
ANGEL_API_KEY=
ANGEL_REDIRECT_URL=http://localhost:8000/api/broker/angel/callback
ANGEL_API_BASE=https://apiconnect.angelone.in
ANGEL_LOGIN_URL=https://smartapi.angelone.in/publisher-login

# Kotak Neo broker (consumer key from the Kotak Neo "Trade API" card in the app)
# Connect is server-side: the user's mobile number, UCC, TOTP and MPIN are posted
# to /broker/connect/{account}/kotak (no OAuth redirect).
KOTAK_CONSUMER_KEY=
KOTAK_API_BASE=https://mis.kotaksecurities.com

# Free News API (https://freenewsapi.io) — news sentiment feeds the signal score.
# Get a key at https://freenewsapi.io/account. Sent (unused) as x-api-key header.
NEWS_API_KEY=
NEWS_API_BASE_URL=https://api.freenewsapi.io/v1
NEWS_ENABLED=true
NEWS_LANGUAGE=en
NEWS_COUNTRY=in
NEWS_RESULTS=10

# Market holiday calendar (data bundled from apptastic-software/trading-calendar,
# see database/data/NOTICE.md — pure PHP at runtime, no Python on the server).
# MARKET_CALENDAR_MIC=XBOM
# MARKET_CALENDAR_SOURCE_FILE=
